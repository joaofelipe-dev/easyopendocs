# ---------------------------------------------------------------------------
# Banco de dados (Postgres do docker-compose.yml)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://easyopendocs:easyopendocs@localhost:5433/easyopendocs?schema=public"

# Banco separado, mesma instância — usado por `npm test` (tests/README.md).
# `tests/global-setup.ts` cria esse banco sozinho na primeira execução.
TEST_DATABASE_URL="postgresql://easyopendocs:easyopendocs@localhost:5433/easyopendocs_test?schema=public"

# ---------------------------------------------------------------------------
# NextAuth / Auth.js
# Gere um segredo com: openssl rand -base64 32
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET="troque-este-valor-por-um-segredo-aleatorio"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# Conteúdo
# Diretório raiz das documentações. Relativo à raiz do projeto ou absoluto.
# ---------------------------------------------------------------------------
CONTENT_ROOT="content/departamentos"

# ---------------------------------------------------------------------------
# Origens extras liberadas pelo `next dev` (separadas por vírgula). Necessário
# só se você acessa o servidor de desenvolvimento por outro host da rede, e
# não por localhost. Ex.: "192.168.0.10"
# ---------------------------------------------------------------------------
DEV_ALLOWED_ORIGINS=""

# ---------------------------------------------------------------------------
# Histórico de versões: quantas versões guardar por documento.
# O snapshot é o arquivo inteiro, então isto é o teto de crescimento do banco.
# ---------------------------------------------------------------------------
DOCUMENT_HISTORY_LIMIT="50"

# ---------------------------------------------------------------------------
# Credenciais criadas pelo `prisma db seed`.
# TROQUE ANTES DE QUALQUER USO REAL.
# ---------------------------------------------------------------------------
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_PASSWORD="admin123"

# Senha inicial dos usuários de exemplo criados pelo seed. Todos entram com
# troca de senha obrigatória no primeiro acesso.
SEED_USER_PASSWORD="teste123"
