// Schema do easyopendocs.
// A connection string vive em prisma.config.ts (Prisma 7), não aqui.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Identidade
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  isSuperAdmin Boolean  @default(false)
  isActive     Boolean  @default(true)
  mustChangePassword Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  departmentRoles UserDepartmentRole[]
  createdDocuments Document[]         @relation("DocumentAuthor")
  documentVersions DocumentVersion[]  @relation("DocumentVersionAuthor")

  @@index([email])
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions     RolePermission[]
  departmentRoles UserDepartmentRole[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

/// Um usuário pode ter múltiplos papéis, em múltiplos departamentos,
/// simultaneamente. A chave composta impede duplicar o mesmo papel no mesmo
/// departamento, mas não impede (userA, depA, Viewer) + (userA, depA, Editor).
model UserDepartmentRole {
  id           String   @id @default(cuid())
  userId       String
  departmentId String
  roleId       String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId, roleId])
  @@index([departmentId])
  @@index([roleId])
}

// ---------------------------------------------------------------------------
// Conteúdo (espelho do filesystem)
// ---------------------------------------------------------------------------

model Department {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  /// Caminho relativo a CONTENT_ROOT (normalmente igual ao slug).
  path        String
  /// Pasta sumiu do filesystem: some da UI mas preserva permissões e histórico.
  isOrphan    Boolean  @default(false)
  /// Padrão de dias entre revisões para os documentos deste departamento, do
  /// `reviewEveryDays` do `_departamento.json`. O front-matter do documento
  /// sobrepõe; sem nenhum dos dois, o departamento fica fora do ciclo.
  reviewIntervalDays Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents Document[]
  userRoles UserDepartmentRole[]

  @@index([isOrphan])
}

model Document {
  id           String   @id @default(cuid())
  departmentId String
  slug         String
  title        String
  description  String?
  /// Caminho relativo à raiz do projeto, ex: content/departamentos/rh/x.html
  filePath     String   @unique
  /// SHA-256 do arquivo, usado para pular reprocessamento no sync incremental.
  contentHash  String
  /// mtime do arquivo no último sync (comparação barata antes do hash).
  fileMtime    DateTime
  fileSize     Int      @default(0)
  isOrphan     Boolean  @default(false)
  /// Texto puro do corpo já sanitizado, extraído no sync. Existe para
  /// alimentar a busca e para o `highlight()` do FTS5 ter de onde tirar o
  /// trecho.
  plainText    String   @default("")
  /// Versão do indexador (conteúdo da tabela `DocumentFts`). Quando não bate
  /// com SEARCH_INDEX_VERSION, o sync reprocessa o arquivo mesmo que o mtime e
  /// o hash não tenham mudado — é o que faz o backfill acontecer sozinho.
  searchVersion Int     @default(0)
  /// Dias entre revisões, do front-matter `reviewEvery`. O arquivo continua
  /// sendo a fonte: estes dois campos são índice, preenchidos pelo sync.
  reviewIntervalDays Int?
  /// Data da última revisão, do front-matter `reviewedAt`.
  lastReviewedAt DateTime?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("DocumentAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  versions   DocumentVersion[]

  @@unique([departmentId, slug])
  @@index([departmentId, isOrphan])
}

/// De onde veio a versão. `FILESYSTEM` é o padrão quando o sync acha conteúdo
/// novo sem que nenhuma tela do portal tenha pedido — git, FTP, `cp` no
/// servidor. Distinguir isso é metade do motivo de o histórico existir.
///
/// SQLite não tem enum no Prisma: o valor vira String e os literais são
/// garantidos pelos pontos de uso (sync/actions), que só gravam estas chaves.
model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  /// Sequencial por documento, começando em 1. Nunca reaproveitado: a poda por
  /// retenção apaga versões antigas, mas não renumera as que ficam.
  version     Int
  title       String
  description String?
  /// O conteúdo bruto do arquivo, exatamente como estava no disco.
  rawHtml     String
  contentHash String
  byteSize    Int      @default(0)
  source      String   @default("FILESYSTEM")
  authorId    String?
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author   User?    @relation("DocumentVersionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([documentId, version])
  @@index([documentId, createdAt])
  @@index([authorId])
}

// ---------------------------------------------------------------------------
// Observabilidade do sync
// ---------------------------------------------------------------------------

model SyncLog {
  id          String      @id @default(cuid())
  trigger     String      @default("AUTOMATIC")
  startedAt   DateTime    @default(now())
  finishedAt  DateTime?
  durationMs  Int         @default(0)
  ok          Boolean     @default(true)
  error       String?

  departmentsCreated Int @default(0)
  departmentsUpdated Int @default(0)
  departmentsOrphaned Int @default(0)
  documentsCreated   Int @default(0)
  documentsUpdated   Int @default(0)
  documentsOrphaned  Int @default(0)
  documentsSkipped   Int @default(0)

  @@index([startedAt])
}
